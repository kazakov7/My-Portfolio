# Supabase project configuration (Get these from your Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
# IMPORTANT: Use the service_role secret key, NOT the anon public key (needed to bypass RLS)
SUPABASE_KEY=your-supabase-service-role-secret-key

# Secret key used to access the private /admin page
ADMIN_KEY=your-strong-secret-admin-password
